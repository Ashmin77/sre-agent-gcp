# Copy this file to .env and fill in your values.
# agent/.env is gitignored because it contains project-specific URLs.
#
# After running Terraform, get values with:
#   terraform -chdir=iac output -raw <name>

# GCP project and region
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Gemini model — gemini-2.5-flash is the default
GEMINI_MODEL=gemini-2.5-flash

# Custom MCP server URL (Cloud Run)
# Get from: terraform -chdir=iac output -raw custom_mcp_url
K8S_MCP_URL=https://sre-k8s-mcp-<hash>.us-central1.run.app

# Google-managed GKE Remote MCP — this URL is fixed, do not change
GKE_REMOTE_MCP_URL=https://container.googleapis.com/mcp/read-only

# Evidence bucket (no gs:// prefix)
# Get from: terraform -chdir=iac output -raw evidence_bucket_name
EVIDENCE_BUCKET=your-gcp-project-id-evidence

# Set this after running deploy_agent.py
# Example: projects/123456789/locations/us-central1/reasoningEngines/987654321
# AGENT_RESOURCE_NAME=
